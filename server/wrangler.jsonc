// Tavtav online server (Server v1, epic #278). Three configurations:
//   (top level)  local dev + tests (`npm run dev`, `npm test`): local D1/DO only.
//   staging      `npm run deploy:staging`   → tavtav-server-staging.<subdomain>.workers.dev
//   production   `npm run deploy:production` → tavtav-server.<subdomain>.workers.dev
// Bindings (vars, d1_databases, durable_objects, ratelimits) are NOT inherited by
// environments, so every environment repeats them. The staging/production D1 ids are
// filled in (created 2026-11-27; see REFERENCE.md "Runbook").
// GOOGLE_CLIENT_IDS: the iOS OAuth client id(s) (comma separated; public, not a secret)
// that Google id_tokens must name as `aud`; empty = Sign in with Google answers 503.
// APNS_TEAM_ID (#287): the Apple team of the APNs key (public); the key itself is the
// secrets APNS_KEY_ID + APNS_PRIVATE_KEY (without them pushes are skipped and logged).
// MatchQueue (#287): one Durable Object per auto-match queue (variant + match length).
// PresenceHub (#301): one Durable Object for presence sockets + live challenge events;
// SEARCH_LIMITER (#301): player search by handle, 30/min per account.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tavtav-server-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "ENVIRONMENT": "development", "GIT_COMMIT": "dev", "GOOGLE_CLIENT_IDS": "937853478519-pifv3ciai2ecbo9m4r790ft07v482ag7.apps.googleusercontent.com", "APNS_TEAM_ID": "8XRKL83C4V" },
  "durable_objects": {
    "bindings": [
      { "name": "MATCH_ROOM", "class_name": "MatchRoom" },
      { "name": "MATCH_QUEUE", "class_name": "MatchQueue" },
      { "name": "PRESENCE", "class_name": "PresenceHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["MatchQueue"] },
    { "tag": "v3", "new_sqlite_classes": ["PresenceHub"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tavtav-dev",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "ACCOUNT_LIMITER", "namespace_id": "1002", "simple": { "limit": 240, "period": 60 } },
        { "name": "SEARCH_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  "env": {
    "staging": {
      "name": "tavtav-server-staging",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "vars": { "ENVIRONMENT": "staging", "GIT_COMMIT": "unknown", "GOOGLE_CLIENT_IDS": "937853478519-pifv3ciai2ecbo9m4r790ft07v482ag7.apps.googleusercontent.com", "APNS_TEAM_ID": "8XRKL83C4V" },
      "durable_objects": {
        "bindings": [
          { "name": "MATCH_ROOM", "class_name": "MatchRoom" },
          { "name": "MATCH_QUEUE", "class_name": "MatchQueue" },
          { "name": "PRESENCE", "class_name": "PresenceHub" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["MatchRoom"] },
        { "tag": "v2", "new_sqlite_classes": ["MatchQueue"] },
        { "tag": "v3", "new_sqlite_classes": ["PresenceHub"] }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tavtav-staging",
          "database_id": "9ede3d99-2d0f-4937-9b4b-494dce25bed7",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "IP_LIMITER", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
        { "name": "ACCOUNT_LIMITER", "namespace_id": "2002", "simple": { "limit": 240, "period": 60 } },
        { "name": "SEARCH_LIMITER", "namespace_id": "2003", "simple": { "limit": 30, "period": 60 } }
      ],
      "triggers": { "crons": ["17 * * * *"] }
    },
    "production": {
      "name": "tavtav-server",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "vars": { "ENVIRONMENT": "production", "GIT_COMMIT": "unknown", "GOOGLE_CLIENT_IDS": "937853478519-pifv3ciai2ecbo9m4r790ft07v482ag7.apps.googleusercontent.com", "APNS_TEAM_ID": "8XRKL83C4V" },
      "durable_objects": {
        "bindings": [
          { "name": "MATCH_ROOM", "class_name": "MatchRoom" },
          { "name": "MATCH_QUEUE", "class_name": "MatchQueue" },
          { "name": "PRESENCE", "class_name": "PresenceHub" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["MatchRoom"] },
        { "tag": "v2", "new_sqlite_classes": ["MatchQueue"] },
        { "tag": "v3", "new_sqlite_classes": ["PresenceHub"] }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tavtav-production",
          "database_id": "b241f489-923d-49be-9dd4-3ce3c5e34cc4",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "IP_LIMITER", "namespace_id": "3001", "simple": { "limit": 120, "period": 60 } },
        { "name": "ACCOUNT_LIMITER", "namespace_id": "3002", "simple": { "limit": 240, "period": 60 } },
        { "name": "SEARCH_LIMITER", "namespace_id": "3003", "simple": { "limit": 30, "period": 60 } }
      ],
      "triggers": { "crons": ["23 * * * *"] }
    }
  }
}
