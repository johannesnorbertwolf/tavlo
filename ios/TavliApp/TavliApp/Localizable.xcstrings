        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορεί να μαζέψει με μεγαλύτερο ζάρι από όσο χρειάζεται, από το πιο μακρινό πούλι (όπως στο στάνταρ Πλακωτό). Μεγάλο πλεονέκτημα."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
