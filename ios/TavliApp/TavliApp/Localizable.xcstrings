        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατά μέσο όρο περίπου %@ πιθανότητα νίκης ανά ζαριά, σταθερά σε όλο το παιχνίδι."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به‌طور میانگین حدود %@ شانس برد در هر پرتاب، یکنواخت در طول بازی."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemiddeld zo'n %@ winkans per worp, gelijkmatig door het hele potje."
          }
        }
      }
    },
    "Steady gain, but never bends the dice much in quiet positions." : {
      "localizations" : {
