        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο υπολογιστής μαθαίνει ακόμα μερικά από τα παιχνίδια του Πλήρους Τάβλι. Προς το παρόν παίξε το Πλήρες Τάβλι με δύο παίκτες."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کامپیوتر هنوز در حال یادگرفتن بعضی از بازی‌های تاولی کامل است. فعلاً تاولی کامل را دو نفره بازی کن."
          }
