        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تیز: همیشه بهترین حرکتش را می‌زند، بدون نگاه به جلو."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scherp: altijd de beste zet, zonder vooruit te kijken."
