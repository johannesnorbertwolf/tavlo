    "%@ wins the match. To continue later instead, use the back button." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gewinnt die Partie. Um später weiterzuspielen, nutze stattdessen die Zurück-Taste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Νικητής της παρτίδας: %@. Για να συνεχίσεις αργότερα, πάτησε το κουμπί επιστροφής."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ مسابقه را می‌برد. اگر می‌خواهی بعداً ادامه دهی، از دکمهٔ بازگشت استفاده کن."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wint de partij. Wil je later verder spelen, gebruik dan de terugknop."
