    "Full Tavli plays all three variants in turn." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full Tavli spielt alle drei Varianten nacheinander."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Πλήρες Τάβλι παίζει και τα τρία παιχνίδια με τη σειρά."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاولی کامل هر سه نوع بازی را به نوبت بازی می‌کند."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full Tavli speelt alle drie varianten na elkaar."
          }
        }
      }
    },
    "The colour you play against the computer. Random picks a side for each new game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Farbe, mit der du gegen den Computer spielst. Bei „Zufällig“ wird für jedes neue Spiel eine Seite gelost."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το χρώμα με το οποίο παίζεις απέναντι στον υπολογιστή. Με το «Τυχαία» διαλέγεται πλευρά σε κάθε νέο παιχνίδι."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رنگی که با آن در برابر کامپیوتر بازی می‌کنی. «تصادفی» برای هر بازی جدید یک طرف را انتخاب می‌کند."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kleur waarmee je tegen de computer speelt. Bij ‘Willekeurig’ wordt voor elk nieuw spel een kant geloot."
          }
        }
      }
    },
    "Beginner: often misses the best move." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfänger: verpasst oft den besten Zug."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρχάριος: συχνά χάνει την καλύτερη κίνηση."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مبتدی: اغلب بهترین حرکت را از دست می‌دهد."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginner: mist vaak de beste zet."
          }
        }
      }
    },
    "Casual: still slips up a lot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelegenheitsspieler: patzt noch oft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χαλαρός: κάνει ακόμα πολλά λάθη."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفننی: هنوز زیاد اشتباه می‌کند."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recreatief: vergist zich nog vaak."
          }
        }
      }
    },
    "Relaxed: playable, with frequent slips." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entspannt: spielbar, mit häufigen Patzern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άνετος: παίζεται, αλλά με συχνά λάθη."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آرام: قابل بازی، با اشتباه‌های مکرر."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontspannen: speelbaar, met geregeld een misser."
          }
        }
      }
    },
    "Solid: slips now and then." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solide: patzt hin und wieder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σταθερός: λάθη πού και πού."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محکم: گاهی اشتباه می‌کند."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Degelijk: vergist zich af en toe."
          }
        }
      }
    },
    "Steady: rarely far from its best move." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicher: selten weit vom besten Zug entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σίγουρος: σπάνια μακριά από την καλύτερη κίνηση."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پایدار: به‌ندرت از بهترین حرکتش دور است."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabiel: zelden ver van de beste zet."
          }
        }
      }
    },
    "Strong: only occasional slips." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stark: nur gelegentliche Patzer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δυνατός: μόνο περιστασιακά λάθη."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قوی: فقط گاه‌به‌گاه اشتباه می‌کند."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sterk: slechts af en toe een misser."
          }
        }
      }
    },
    "Sharp: always its best move, without looking ahead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scharf: immer der beste Zug, ohne vorauszuschauen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κοφτερός: πάντα η καλύτερη κίνηση, χωρίς να κοιτάει μπροστά."
