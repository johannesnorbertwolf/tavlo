        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανενεργό στο Πλήρες Τάβλι: μόνο στο Πλακωτό με κανόνες σπιτιού, ένα παιχνίδι ή 2 στα 3."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در تاولی کامل خاموش است: فقط در پلاکوتو با قوانین خانگی، تک‌بازی یا بهترین از ۳."
