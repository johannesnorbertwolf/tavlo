    "Both mother checkers are pinned — nobody scores." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Mutter-Steine sind festgesetzt – niemand punktet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Και οι δύο μάνες είναι πλακωμένες — κανείς δεν παίρνει πόντους."
          }
        },
        "nl" : {
          "stringUnit" : {
