    "Equal points after three games — the session is drawn." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleich viele Punkte nach drei Partien – das Full Tavli endet unentschieden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ίσοι πόντοι μετά από τρία παιχνίδια — ισοπαλία."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امتیازها پس از سه بازی برابر است — دوره مساوی شد."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evenveel punten na drie partijen – de Full Tavli eindigt in een gelijkspel."
          }
        }
      }
    },
    "New Full Tavli" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neues Full Tavli"
          }
        },
        "el" : {
          "stringUnit" : {
