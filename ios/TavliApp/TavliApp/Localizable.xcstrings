    "The colour you play against the computer. Random picks a side for each new game." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Farbe, mit der du gegen den Computer spielst. Bei „Zufällig“ wird für jedes neue Spiel eine Seite gelost."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το χρώμα με το οποίο παίζεις απέναντι στον υπολογιστή. Με το «Τυχαία» διαλέγεται πλευρά σε κάθε νέο παιχνίδι."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رنگی که با آن در برابر کامپیوتر بازی می‌کنی. «تصادفی» برای هر بازی جدید یک طرف را انتخاب می‌کند."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kleur waarmee je tegen de computer speelt. Bij ‘Willekeurig’ wordt voor elk nieuw spel een kant geloot."
          }
        }
      }
    },
    "The computer is still learning %@. Play it with two players for now." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Computer lernt %@ noch. Spiel es vorerst zu zweit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο υπολογιστής μαθαίνει ακόμα: %@. Προς το παρόν παίξε με δύο παίκτες."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کامپیوتر هنوز در حال یادگرفتن %@ است. فعلاً آن را دو نفره بازی کن."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De computer leert %@ nog. Speel het voorlopig met z'n tweeën."
          }
        }
      }
    },
    "The computer is still learning some of the Full Tavli games. Play Full Tavli with two players for now." : {
      "extractionState" : "stale",
