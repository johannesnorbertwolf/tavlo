          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipps zählen nicht mit: Was sie wert sind, hängt vom Spieler ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι βοήθειες δεν μετράνε: η αξία τους εξαρτάται από τον παίκτη."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hints tellen niet mee: wat ze waard zijn hangt af van de speler."
          }
        }
      }
    },
    "If both played at the computer's full strength." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn beide mit voller Computerstärke spielten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν έπαιζαν και οι δύο με την πλήρη δύναμη του υπολογιστή."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als beide op de volle sterkte van de computer speelden."
          }
        }
      }
    },
    "Not counted in your record against the computer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt nicht zu deiner Bilanz gegen den Computer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν μετράει στο ρεκόρ σου απέναντι στον υπολογιστή."
