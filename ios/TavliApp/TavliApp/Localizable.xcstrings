    "The opening roll decides who starts, unless you force a side." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Eröffnungswurf entscheidet, wer beginnt, außer du legst eine Seite fest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ζαριά έναρξης αποφασίζει ποιος ξεκινάει, εκτός αν διαλέξεις εσύ."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاس شروع تعیین می‌کند چه کسی اول بازی کند، مگر اینکه خودت یک طرف را انتخاب کنی."
          }
        },
        "nl" : {
          "stringUnit" : {
