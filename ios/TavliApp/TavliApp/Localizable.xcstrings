    "Land on a lone opposing checker to pin it until you leave. Every win counts one point." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh auf einen einzelnen gegnerischen Stein, um ihn festzusetzen, bis du weiterziehst. Jeder Sieg zählt einen Punkt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πλάκωσε μοναχό πούλι του αντιπάλου μέχρι να φύγεις. Κάθε νίκη μετράει έναν πόντο."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی یک مهرهٔ تنهای حریف فرود بیا تا آن را حبس کنی تا وقتی که از آنجا بروی. هر برد یک امتیاز دارد."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Land op een losse steen van je tegenstander om hem vast te zetten tot je verder gaat. Elke winst telt één punt."
          }
        }
      }
    },
    "Land on a lone opposing checker to pin it; pinning the mother checker can win two points." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh auf einen einzelnen gegnerischen Stein, um ihn festzusetzen; wer den Mutterstein festsetzt, kann zwei Punkte gewinnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πλάκωσε μοναχό πούλι του αντιπάλου. Με πλακωμένη μάνα μπορείς να πάρεις δύο πόντους."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روی یک مهرهٔ تنهای حریف فرود بیا تا حبسش کنی؛ حبس کردن مهرهٔ مادر می‌تواند دو امتیاز بیاورد."
