    "Give one side an advantage so players of different strength get a close game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einer Seite einen Vorteil, damit unterschiedlich starke Spieler ein enges Spiel haben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δώσε πλεονέκτημα σε μία πλευρά, ώστε παίκτες διαφορετικού επιπέδου να παίξουν ένα ισορροπημένο παιχνίδι."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به یک طرف برتری بده تا بازیکنان با قدرت متفاوت بازی نزدیکی داشته باشند."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef één kant een voordeel, zodat spelers van verschillend niveau een spannend spel spelen."
          }
        }
      }
    },
    "Give up" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
